node_modules/
.claude

# Runtime data — scores, users, audit logs, credentials (server-side only)
**/data/*
!**/data/
!**/data/.htaccess
!**/data/*.sample.json
!**/data/README.md
# Frontlines categories are code-managed config (deployed via git, not in-app edited).
# If you ever want categories editable in-app instead, drop this line.
!**/data/categories.json

# Runtime uploads — keep user-provided audio out of source control.
**/media/walkup/*
!**/media/
!**/media/walkup/
!**/media/walkup/.htaccess

