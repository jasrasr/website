Options -Indexes

# Uploaded content must never run as a server-side script, including double extensions.
<FilesMatch "(?i)\.(php[0-9]*|phtml|phar|cgi|pl|py|rb|sh|asp|aspx|jsp|shtml)(\.|$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
