# File Name: .htaccess
# Author: Jason Lamb (with help from ChatGPT)
# Description: Block HTTP access to local private settings.
# Revision: 1.0.0
# Created Date: 2026-10-29
# Modified Date: 2026-10-29
# Changelog: 1.0.0 - Protect config.local.php and example copies.
<FilesMatch "^config\.local\.(?:example\.)?php$">
  Require all denied
</FilesMatch>
