# File: .gitignore
# Purpose: Excludes local finance secrets and generated budget data.
# Revision: 1.1
# Revision Log:
# - 2026-05-15: Added revision metadata to the file header.

/data/*.json
/data/*.lock
/data/identity/
/data/.budget-*
/config.local.php
/config.private.php
/security.md

# Entire runtime tree, including future migration files. Keep only HTTP protection.
/data/*
!/data/.htaccess
