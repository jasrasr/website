# File Name: .htaccess
# Author: Jason Lamb (with help from ChatGPT)
# Description: Deny HTTP access to local configuration, templates and backup variants.
# Revision: 1.0.1
# Created Date: 2026-10-21
# Modified Date: 2026-10-21
# Changelog: 1.0.1 - Protect all config.local prefixes including hidden editor and backup names. 1.0.0 - Protect local AI configuration and related templates.
<FilesMatch "(?i)^[.#~]*config\.local">
    Require all denied
</FilesMatch>
